{
  "name": "livetrivia",
  "version": "0.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"webpack serve\" \"set BEARCAT_GAME_DEBUG=true&& npx tsc -p tsconfig.server.json && node dist-server/server.js\"",
    "build": "npx tsc -p tsconfig.server.json && webpack --mode production",
    "start": "node dist-server/server.js",
    "lint": "xo --fix || uvx ruff check || uvx ruff format",
    "install:venv": "uv sync --all-extras",
    "install:mistral": "node -e \"require('fs').mkdirSync('models/mistral-7b', { recursive: true })\" && uvx --from huggingface_hub hf download mistralai/Mistral-7B-Instruct-v0.3 --local-dir ./models/mistral-7b",
    "docker:s3": "node ./scripts/docker-s3.js",
    "docker:sgl": "node ./scripts/docker-sgl.js",
    "dev:sgl": "python -m sglang.launch_server --model /models/mistral-7b --context-length 32000 --tp 1 --quantization fp8 --kv-cache-dtype fp8_e5m2 --attention-backend triton --chunked-prefill-size 4096 --mem-fraction-static 0.8 --enable-torch-compile --host 0.0.0.0 --port 30000",
    "dev:api": "uv run -- python -m uvicorn livetrivia._api:api --app-dir src --reload --reload-dir src/livetrivia",
    "dev:app": "uv run -- python ./src/livetrivia/_app.py"
  },
  "author": "HDTHREE",
  "dependencies": {
    "@types/three": "^0.181.0",
    "anki-reader": "^0.1.1",
    "express": "^5.2.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "three": "^0.181.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "concurrently": "^9.1.2",
    "copy-webpack-plugin": "^14.0.0",
    "html-webpack-plugin": "^5.6.4",
    "ts-loader": "^9.5.4",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2",
    "xo": "^2.0.2"
  },
  "xo": [
    {
      "ignores": [
        "webpack.config.js",
        "src/**/index.{js,ts,jsx,tsx}"
      ]
    },
    {
      "files": [
        "src/**/*.{ts,tsx,mts,cts}"
      ],
      "languageOptions": {
        "parserOptions": {
          "projectService": false,
          "project": "./tsconfig.json"
        }
      }
    },
    {
      "files": [
        "server.ts"
      ],
      "languageOptions": {
        "parserOptions": {
          "projectService": false,
          "project": "./tsconfig.server.json"
        }
      }
    }
  ]
}
